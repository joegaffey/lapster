{
  "name": "web-sim-engine-web",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test src/types/asset-layout.test.ts tests/fixtures.test.ts tests/pack-loader.test.ts tests/sab.test.ts tests/wheel-feel.test.ts tests/net-room.test.ts tests/race-contract.test.ts tests/race-state-contract.test.ts tests/remote-state.test.ts",
    "build:viewer": "bash scripts/build-viewer.sh",
    "build:track-ed": "bash scripts/build-track-ed.sh",
    "check:track-ed": "python3 scripts/check-track-ed-deps.py",
    "serve:multiplayer": "bash scripts/serve-multiplayer.sh",
    "serve:relay": "bash scripts/serve-relay.sh",
    "test:viewer": "npm run build:viewer && bash scripts/test-viewer.sh",
    "test:all": "npm test && npm run test:viewer",
    "bench:physics": "RUN_PHYSICS_PERF=1 npm run test:viewer -- tests/physics-perf.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2"
  }
}
