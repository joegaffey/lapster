{
  "name": "Lapster relay multiplayer",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Lapster relay",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "cargo install wasm-bindgen-cli --version 0.2.129 --locked && cd web && npm ci && npm run build:viewer && bash scripts/build-pages.sh",
  "postStartCommand": "setsid -f bash web/scripts/serve-multiplayer.sh >/tmp/lapster-relay.log 2>&1",
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "ms-playwright.playwright"]
    }
  }
}
