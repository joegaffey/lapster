{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "small_model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "architect",
  "instructions": ["AGENTS.md"],
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 16000
    }
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 32768
  },
  "permission": {
    "bash": {
      "ls*": "allow",
      "cat*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "wc*": "allow",
      "stat*": "allow",
      "file*": "allow",
      "du*": "allow",
      "tree*": "allow",
      "grep*": "allow",
      "rg*": "allow",
      "sed -n *": "allow",
      "awk*": "allow",
      "jq*": "allow",
      "sort*": "allow",
      "uniq*": "allow",
      "cut*": "allow",
      "tr*": "allow",
      "basename*": "allow",
      "dirname*": "allow",
      "readlink*": "allow",
      "realpath*": "allow",
      "seq*": "allow",
      "printf*": "allow",
      "which*": "allow",
      "command -v*": "allow",
      "test -f*": "allow",
      "test -d*": "allow",
      "true*": "allow",
      "sleep*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-list*": "allow",
      "git ls-files*": "allow",
      "git merge-base*": "allow",
      "git branch --list*": "allow",
      "git branch -a*": "allow",
      "git branch -vv*": "allow",
      "git tag --list*": "allow",
      "git tag -l*": "allow",
      "git remote -v*": "allow",
      "git remote show*": "allow",
      "git -C * status*": "allow",
      "git -C * diff*": "allow",
      "git -C * log*": "allow",
      "git -C * show*": "allow",
      "git -C * rev-list*": "allow",
      "git -C * ls-files*": "allow",
      "git -C * merge-base*": "allow",
      "cargo metadata*": "allow",
      "cargo tree*": "allow",
      "cargo fmt --check*": "allow",
      "npm ls*": "allow",
      "npm audit": "allow",
      "npm audit --*": "allow",
      "npm view*": "allow",
      "npm outdated*": "allow",
      "npx tsc --noEmit*": "allow",
      "node --version*": "allow",
      "python3 scripts/check-agent-sync.py*": "allow"
    },
    "read": {
      "*": "allow",
      "target/**": "deny",
      "web/node_modules/**": "deny",
      "web/track-ed-src/node_modules/**": "deny",
      "web/track-ed-src/dist/**": "deny",
      "web/track-ed-src/package-lock.json": "deny",
      "tools/speed-dreams/node_modules/**": "deny",
      "web/pkg/**": "deny",
      "web/track-ed/**": "deny",
      "web/.cache/**": "deny",
      "dist/**": "deny",
      "fixtures/real/**": "deny",
      "web/test-results/**": "deny",
      "web/playwright-report/**": "deny",
      "**/*.kn5": "deny",
      "**/*.log": "deny",
      ".env*": "deny",
      "web/src/version.generated.ts": "deny",
      "web/version.json": "deny",
      "web/drive/main.js": "deny",
      "web/garage/main.js": "deny",
      "web/multiplayer/main.js": "deny",
      "web/track-viewer/main.js": "deny",
      "web/style-spike/main.js": "deny",
      "web/track-editor/main.js": "deny",
      "web/worker/physics-worker.js": "deny",
      "web/audio/combustion-worklet.js": "deny",
      "Cargo.lock": "deny",
      "web/package-lock.json": "deny",
      "tools/speed-dreams/package-lock.json": "deny"
    },
    "external_directory": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.config/opencode/auth.json": "deny",
      "~/.config/opencode/server.env": "deny"
    }
  }
}
